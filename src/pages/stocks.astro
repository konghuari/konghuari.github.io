---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '招商银行', code: 'sh600036', close: '38.49', change: '-0.03%', state: '强势整理', trigger: '放量站稳 38.8' },
  { rank: 2, name: '美的集团', code: 'sz000333', close: '82.36', change: '-0.59%', state: '中性偏强', trigger: '收复 82.4-83.0' },
  { rank: 3, name: '宁德时代', code: 'sz300750', close: '399.50', change: '+1.65%', state: '弱反弹', trigger: '收复 406-414' },
  { rank: 4, name: '比亚迪', code: 'sz002594', close: '91.89', change: '+0.77%', state: '弱反弹', trigger: '收复 92.9-94.2' },
  { rank: 5, name: '中国移动', code: 'sh600941', close: '95.86', change: '-0.77%', state: '跌破短均', trigger: '收回 96.9-97.1' },
  { rank: 6, name: '海尔智家', code: 'sh600690', close: '20.07', change: '-0.50%', state: '弱势整理', trigger: '收复 20.3-20.5' },
  { rank: 7, name: '贵州茅台', code: 'sh600519', close: '1256.00', change: '-0.55%', state: '缩量偏弱', trigger: '收复 1268-1286' },
  { rank: 8, name: '迈瑞医疗', code: 'sz300760', close: '142.33', change: '-0.29%', state: '低位弱势', trigger: '收复 143.3-146.8' },
];

const usRows = [
  { rank: 1, name: '谷歌-A', code: 'usGOOGL', close: '361.20', change: '-0.58%', state: '相对抗跌', trigger: '收复 364.4-374.5' },
  { rank: 2, name: 'Meta', code: 'usMETA', close: '586.85', change: '+0.25%', state: '低位企稳', trigger: '收复 605-614' },
  { rank: 3, name: '亚马逊', code: 'usAMZN', close: '243.73', change: '-0.61%', state: '弱势横盘', trigger: '收复 250-259' },
  { rank: 4, name: '英伟达', code: 'usNVDA', close: '201.72', change: '-3.32%', state: '跌破短均', trigger: '收复 212-214' },
  { rank: 5, name: '微软', code: 'usMSFT', close: '401.63', change: '-2.46%', state: '继续转弱', trigger: '收复 421-423' },
  { rank: 6, name: '苹果', code: 'usAAPL', close: '289.59', change: '-3.96%', state: '转弱破位', trigger: '收复 304-308' },
  { rank: 7, name: '特斯拉', code: 'usTSLA', close: '389.46', change: '-4.77%', state: '最弱', trigger: '收复 409-421' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 25',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-06-09 收盘；美股 2026-06-09 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>招商银行最强，美的集团守在强弱线附近</strong>
          <p>多数标的缩量偏弱，宁德时代和比亚迪只是弱反弹。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>科技股全面跌破短均线，只看修复确认</strong>
          <p>谷歌和 Meta 相对抗跌，苹果、特斯拉、英伟达转弱更明显。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
