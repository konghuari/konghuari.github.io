---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '招商银行', code: 'sh600036', close: '38.58', change: '+1.26%', state: '强势延续', trigger: '站稳 38.7 附近' },
  { rank: 2, name: '中国移动', code: 'sh600941', close: '97.33', change: '-0.64%', state: '趋势偏稳', trigger: '重新站上 97.6-98.0' },
  { rank: 3, name: '美的集团', code: 'sz000333', close: '81.69', change: '-0.89%', state: '中性偏强', trigger: '收回 82.2' },
  { rank: 4, name: '迈瑞医疗', code: 'sz300760', close: '144.39', change: '+1.26%', state: '弱修复', trigger: '站回 145.6' },
  { rank: 5, name: '贵州茅台', code: 'sh600519', close: '1272.86', change: '+0.38%', state: '弱修复', trigger: '收复 1288-1290' },
  { rank: 6, name: '海尔智家', code: 'sh600690', close: '20.31', change: '-0.25%', state: '偏弱', trigger: '收复 20.7' },
  { rank: 7, name: '比亚迪', code: 'sz002594', close: '93.01', change: '-0.46%', state: '偏弱', trigger: '收复 94.3-95.2' },
  { rank: 8, name: '宁德时代', code: 'sz300750', close: '403.00', change: '-1.27%', state: '最弱', trigger: '收复 408-415' },
];

const usRows = [
  { rank: 1, name: '苹果', code: 'usAAPL', close: '307.34', change: '-1.25%', state: '相对最稳', trigger: '维持 307-310 区间' },
  { rank: 2, name: '谷歌-A', code: 'usGOOGL', close: '368.53', change: '-0.59%', state: '短线修复', trigger: '重新站上 372' },
  { rank: 3, name: 'Meta', code: 'usMETA', close: '593.00', change: '-4.90%', state: '大阴后观察', trigger: '收回 608-617' },
  { rank: 4, name: '英伟达', code: 'usNVDA', close: '205.10', change: '-6.20%', state: '转弱', trigger: '收回 215-217' },
  { rank: 5, name: '微软', code: 'usMSFT', close: '416.67', change: '-2.75%', state: '跌破短均', trigger: '收回 422-430' },
  { rank: 6, name: '亚马逊', code: 'usAMZN', close: '246.03', change: '-3.05%', state: '偏弱', trigger: '收回 253-254' },
  { rank: 7, name: '特斯拉', code: 'usTSLA', close: '391.00', change: '-6.56%', state: '最弱', trigger: '收回 414-425' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 12',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ... --date 2026-06-05',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-06-05 收盘；美股 2026-06-05 收盘。周一使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>招商银行、中国移动、美的集团相对靠前</strong>
          <p>优先看强势延续，不追跌破短均线后的弱反弹。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>大型科技股整体转弱，先看修复</strong>
          <p>苹果和谷歌相对稳，英伟达、特斯拉需先收复短期均线。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>周一触发</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
