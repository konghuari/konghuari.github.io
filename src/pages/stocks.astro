---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '美的集团', code: 'sz000333', close: '82.85', change: '+1.42%', state: '相对最强', trigger: '守住 82.4，放量上攻 83.7' },
  { rank: 2, name: '招商银行', code: 'sh600036', close: '38.50', change: '-0.21%', state: '强势整理', trigger: '重新站稳 38.7' },
  { rank: 3, name: '中国移动', code: 'sh600941', close: '96.60', change: '-0.75%', state: '趋势转弱边缘', trigger: '收回 97.6' },
  { rank: 4, name: '海尔智家', code: 'sh600690', close: '20.17', change: '-0.69%', state: '弱势整理', trigger: '收复 20.5' },
  { rank: 5, name: '迈瑞医疗', code: 'sz300760', close: '142.74', change: '-1.14%', state: '弱修复失败', trigger: '收复 144.3-145.0' },
  { rank: 6, name: '贵州茅台', code: 'sh600519', close: '1262.98', change: '-0.78%', state: '继续偏弱', trigger: '收复 1278-1288' },
  { rank: 7, name: '比亚迪', code: 'sz002594', close: '91.19', change: '-1.96%', state: '破位偏弱', trigger: '收复 93.8-94.7' },
  { rank: 8, name: '宁德时代', code: 'sz300750', close: '393.02', change: '-2.48%', state: '最弱', trigger: '收复 403-413' },
];

const usRows = [
  { rank: 1, name: '苹果', code: 'usAAPL', close: '313.71', change: '+2.17%', state: '相对最强', trigger: '守住 311.5，冲击 315' },
  { rank: 2, name: '特斯拉', code: 'usTSLA', close: '404.97', change: '+3.57%', state: '弱势反弹', trigger: '收复 412-423' },
  { rank: 3, name: '英伟达', code: 'usNVDA', close: '208.76', change: '+1.78%', state: '弱反弹', trigger: '收复 214-215' },
  { rank: 4, name: '亚马逊', code: 'usAMZN', close: '246.43', change: '+0.16%', state: '低位横盘', trigger: '收复 250.5' },
  { rank: 5, name: '谷歌-A', code: 'usGOOGL', close: '362.11', change: '-1.77%', state: '偏弱', trigger: '收复 364.7-374.8' },
  { rank: 6, name: '微软', code: 'usMSFT', close: '410.62', change: '-1.45%', state: '继续转弱', trigger: '收复 422-425' },
  { rank: 7, name: 'Meta', code: 'usMETA', close: '587.95', change: '-0.51%', state: '大阴后低位', trigger: '收复 605-615' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 12',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-06-08 收盘；美股 2026-06-08 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>美的集团最强，招商银行维持强势整理</strong>
          <p>中国移动跌回短均线附近；宁德时代、比亚迪继续偏弱。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>苹果相对最强，科技股多数仍在修复</strong>
          <p>特斯拉、英伟达属于弱势反弹，需先收复短期均线。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>周一触发</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
