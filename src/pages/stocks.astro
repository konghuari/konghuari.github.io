---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '迈瑞医疗', code: 'sz300760', close: '149.43', change: '-0.59%', state: '强势整理', trigger: '守住 145.1，突破 152.9' },
  { rank: 2, name: '美的集团', code: 'sz000333', close: '82.71', change: '+1.11%', state: '放量延续', trigger: '守住 81.8，突破 83.5' },
  { rank: 3, name: '招商银行', code: 'sh600036', close: '38.02', change: '+0.93%', state: '放量趋势', trigger: '守住 37.6，突破 38.2' },
  { rank: 4, name: '中国移动', code: 'sh600941', close: '93.40', change: '+0.38%', state: '放量延续', trigger: '守住 92.5，突破 94.6' },
  { rank: 5, name: '贵州茅台', code: 'sh600519', close: '1253.00', change: '-0.48%', state: '高位整理', trigger: '守住 1237.8，突破 1269.3' },
  { rank: 6, name: '比亚迪', code: 'sz002594', close: '93.47', change: '-0.71%', state: '强势整理', trigger: '守住 91.3，突破 96.0' },
  { rank: 7, name: '海尔智家', code: 'sh600690', close: '20.95', change: '-0.76%', state: '缩量整理', trigger: '守住 20.7，突破 21.3' },
  { rank: 8, name: '宁德时代', code: 'sz300750', close: '360.00', change: '-1.69%', state: '跌回均线下', trigger: '收复 364.5-365.5' },
];

const usRows = [
  { rank: 1, name: '苹果', code: 'usAAPL', close: '333.74', change: '+0.14%', state: '放量强势', trigger: '守住 325.3，突破 335.0' },
  { rank: 2, name: '微软', code: 'usMSFT', close: '393.82', change: '-1.82%', state: '强势回踩', trigger: '守住 393.3，突破 406.0' },
  { rank: 3, name: '亚马逊', code: 'usAMZN', close: '247.23', change: '-1.06%', state: '均线边缘', trigger: '收复 249.4-258.1' },
  { rank: 4, name: 'Meta', code: 'usMETA', close: '646.01', change: '-2.79%', state: '跌破 5 日线', trigger: '收复 661.9-686.1' },
  { rank: 5, name: '英伟达', code: 'usNVDA', close: '202.81', change: '-2.21%', state: '跌破短均', trigger: '收复 204.8-207.6' },
  { rank: 6, name: '标普500ETF', code: 'usSPY', close: '743.29', change: '-0.99%', state: '跌破均线', trigger: '收复 745.0-750.1' },
  { rank: 7, name: '纳指100ETF', code: 'usQQQ', close: '695.33', change: '-1.50%', state: '放量转弱', trigger: '收复 710.1-714.3' },
  { rank: 8, name: '谷歌-A', code: 'usGOOGL', close: '346.77', change: '-2.17%', state: '继续偏弱', trigger: '收复 355.9-359.6' },
  { rank: 9, name: '博通', code: 'usAVGO', close: '370.83', change: '-0.97%', state: '跌破均线', trigger: '收复 381.8-384.7' },
  { rank: 10, name: '特斯拉', code: 'usTSLA', close: '380.84', change: '-2.61%', state: '弱势下行', trigger: '收复 391.5-398.8' },
  { rank: 11, name: 'AMD', code: 'usAMD', close: '495.76', change: '-1.03%', state: '最弱', trigger: '收复 521.7-533.0' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 25',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-17 收盘；美股 2026-07-17 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>迈瑞医疗、美的集团、招商银行相对靠前</strong>
          <p>A 股观察清单多数仍在 5/10/20 日线上方；宁德时代重新跌回短均线下。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>苹果独强，美股科技线多数转弱</strong>
          <p>QQQ、SPY 均跌破 5/10/20 日线；英伟达、Meta 跌破 5 日线，AMD 最弱。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
