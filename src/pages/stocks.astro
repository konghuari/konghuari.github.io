---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '迈瑞医疗', code: 'sz300760', close: '146.00', change: '+4.32%', state: '放量突破', trigger: '守住 141.3，突破 147.6' },
  { rank: 2, name: '贵州茅台', code: 'sh600519', close: '1251.06', change: '+2.98%', state: '放量突破', trigger: '守住 1212.8，突破 1256.6' },
  { rank: 3, name: '海尔智家', code: 'sh600690', close: '21.02', change: '+3.39%', state: '放量转强', trigger: '守住 20.4，突破 21.1' },
  { rank: 4, name: '比亚迪', code: 'sz002594', close: '91.76', change: '+1.75%', state: '强势延续', trigger: '守住 89.2，突破 93.5' },
  { rank: 5, name: '美的集团', code: 'sz000333', close: '82.67', change: '+1.84%', state: '强势延续', trigger: '守住 80.5，突破 82.8' },
  { rank: 6, name: '宁德时代', code: 'sz300750', close: '373.00', change: '+2.47%', state: '修复加速', trigger: '收复 381.5' },
  { rank: 7, name: '中国移动', code: 'sh600941', close: '92.80', change: '+1.09%', state: '趋势延续', trigger: '守住 90.9，突破 93.0' },
  { rank: 8, name: '招商银行', code: 'sh600036', close: '37.76', change: '+1.56%', state: '强势整理', trigger: '守住 37.1，突破 38.0' },
];

const usRows = [
  { rank: 1, name: '英伟达', code: 'usNVDA', close: '211.80', change: '+4.06%', state: '强势反包', trigger: '守住 206.6，突破 212.6' },
  { rank: 2, name: 'Meta', code: 'usMETA', close: '661.04', change: '+0.66%', state: '高位延续', trigger: '守住 644.3，突破 677.9' },
  { rank: 3, name: 'AMD', code: 'usAMD', close: '548.13', change: '+2.57%', state: '修复转强', trigger: '守住 540.9，突破 574.2' },
  { rank: 4, name: '标普500ETF', code: 'usSPY', close: '751.83', change: '+0.36%', state: '趋势偏强', trigger: '守住 750.6，突破 755.4' },
  { rank: 5, name: '亚马逊', code: 'usAMZN', close: '247.49', change: '+0.07%', state: '稳步修复', trigger: '守住 246.2，突破 251.0' },
  { rank: 6, name: '谷歌-A', code: 'usGOOGL', close: '359.51', change: '+1.99%', state: '弱修复', trigger: '收复 360.2' },
  { rank: 7, name: '博通', code: 'usAVGO', close: '389.11', change: '+1.32%', state: '修复中', trigger: '收复 392.6-407.5' },
  { rank: 8, name: '苹果', code: 'usAAPL', close: '314.86', change: '-0.77%', state: '高位整理', trigger: '收复 315.4-323.5' },
  { rank: 9, name: '纳指100ETF', code: 'usQQQ', close: '719.69', change: '+1.12%', state: '均线边缘', trigger: '收复 719.8-722.1' },
  { rank: 10, name: '微软', code: 'usMSFT', close: '384.93', change: '-1.55%', state: '转弱整理', trigger: '收复 385.7-393.7' },
  { rank: 11, name: '特斯拉', code: 'usTSLA', close: '396.18', change: '+0.36%', state: '弱势横盘', trigger: '收复 399.9-406.1' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 25',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-15 收盘；美股 2026-07-14 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>迈瑞医疗、贵州茅台、海尔智家放量转强</strong>
          <p>迈瑞医疗和贵州茅台量能显著放大；宁德时代收复 5/10 日线但仍低于 20 日线。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>英伟达反包转强，Meta、AMD 继续靠前</strong>
          <p>SPY 维持趋势偏强；QQQ 仍在 10/20 日线边缘，特斯拉和微软偏弱。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
