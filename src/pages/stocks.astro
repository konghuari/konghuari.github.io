---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '比亚迪', code: 'sz002594', close: '90.18', change: '+3.68%', state: '放量转强', trigger: '守住 88.4，突破 90.8' },
  { rank: 2, name: '美的集团', code: 'sz000333', close: '81.18', change: '+0.97%', state: '强势延续', trigger: '守住 79.9，突破 82.0' },
  { rank: 3, name: '中国移动', code: 'sh600941', close: '91.80', change: '+0.40%', state: '趋势延续', trigger: '守住 90.4，突破 92.1' },
  { rank: 4, name: '迈瑞医疗', code: 'sz300760', close: '139.96', change: '+0.20%', state: '修复确认', trigger: '守住 139.4，突破 143.5' },
  { rank: 5, name: '贵州茅台', code: 'sh600519', close: '1214.88', change: '+0.32%', state: '收复均线', trigger: '守住 1202，突破 1226.9' },
  { rank: 6, name: '招商银行', code: 'sh600036', close: '37.18', change: '-0.19%', state: '强势整理', trigger: '守住 37.0，突破 37.4' },
  { rank: 7, name: '海尔智家', code: 'sh600690', close: '20.33', change: '+0.40%', state: '横盘修复', trigger: '收复 20.34-20.45' },
  { rank: 8, name: '宁德时代', code: 'sz300750', close: '364.01', change: '+1.38%', state: '弱势反弹', trigger: '收复 370.2-383.0' },
];

const usRows = [
  { rank: 1, name: 'Meta', code: 'usMETA', close: '656.73', change: '-1.86%', state: '强势回踩', trigger: '守住 635，突破 677.9' },
  { rank: 2, name: '微软', code: 'usMSFT', close: '390.99', change: '+1.53%', state: '转强修复', trigger: '守住 386.5，突破 395.6' },
  { rank: 3, name: '亚马逊', code: 'usAMZN', close: '247.31', change: '+0.80%', state: '稳步修复', trigger: '守住 245.9，突破 251.0' },
  { rank: 4, name: '苹果', code: 'usAAPL', close: '317.31', change: '+0.63%', state: '高位延续', trigger: '守住 314.6，突破 323.5' },
  { rank: 5, name: '标普500ETF', code: 'usSPY', close: '749.17', change: '-0.77%', state: '趋势整理', trigger: '收复 749.8-755.4' },
  { rank: 6, name: '英伟达', code: 'usNVDA', close: '203.53', change: '-3.52%', state: '跌破 5 日线', trigger: '收复 203.7-211.0' },
  { rank: 7, name: '博通', code: 'usAVGO', close: '384.05', change: '-3.98%', state: '强势回落', trigger: '收复 388.9-407.5' },
  { rank: 8, name: 'AMD', code: 'usAMD', close: '534.39', change: '-4.21%', state: '回落整理', trigger: '收复 540.4-560.3' },
  { rank: 9, name: '纳指100ETF', code: 'usQQQ', close: '711.74', change: '-1.90%', state: '跌破均线', trigger: '收复 716.3-720.3' },
  { rank: 10, name: '谷歌-A', code: 'usGOOGL', close: '352.51', change: '-1.31%', state: '继续偏弱', trigger: '收复 357.6-359.6' },
  { rank: 11, name: '特斯拉', code: 'usTSLA', close: '394.76', change: '-3.19%', state: '最弱', trigger: '收复 400.7-407.7' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 25',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-14 收盘；美股 2026-07-13 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>比亚迪、美的集团、中国移动短线靠前</strong>
          <p>比亚迪放量站上 5/10/20 日线并有主力净流入；宁德时代仍低于 10/20 日线。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>Meta 仍强，微软、亚马逊、苹果修复靠前</strong>
          <p>QQQ 跌破 5/10/20 日线；英伟达回到 5 日线下方但仍守住 10/20 日线。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
