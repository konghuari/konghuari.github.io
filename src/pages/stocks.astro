---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '宁德时代', code: 'sz300750', close: '382.20', change: '+1.53%', state: '资金转强', trigger: '守住 371.6，突破 391.0' },
  { rank: 2, name: '海尔智家', code: 'sh600690', close: '21.85', change: '+1.82%', state: '放量延续', trigger: '守住 21.3，突破 22.3' },
  { rank: 3, name: '比亚迪', code: 'sz002594', close: '94.30', change: '+0.40%', state: '强势整理', trigger: '守住 93.5，突破 96.8' },
  { rank: 4, name: '贵州茅台', code: 'sh600519', close: '1308.00', change: '-1.47%', state: '突破后回踩', trigger: '守住 1279.7，收复 1344.7' },
  { rank: 5, name: '美的集团', code: 'sz000333', close: '84.27', change: '-0.04%', state: '高位整理', trigger: '守住 83.2，突破 85.8' },
  { rank: 6, name: '迈瑞医疗', code: 'sz300760', close: '152.25', change: '-1.46%', state: '强势回踩', trigger: '守住 150.5，突破 156.0' },
  { rank: 7, name: '中国移动', code: 'sh600941', close: '94.94', change: '-0.90%', state: '放量回踩', trigger: '守住 94.0，突破 96.5' },
  { rank: 8, name: '招商银行', code: 'sh600036', close: '37.99', change: '-2.36%', state: '跌破 5 日线', trigger: '收复 38.1-39.4' },
];

const usRows = [
  { rank: 1, name: '微软', code: 'usMSFT', close: '402.29', change: '+2.15%', state: '修复最强', trigger: '守住 395.6，突破 406.0' },
  { rank: 2, name: '亚马逊', code: 'usAMZN', close: '249.99', change: '+1.12%', state: '收复均线', trigger: '守住 249.9，突破 258.1' },
  { rank: 3, name: '苹果', code: 'usAAPL', close: '326.59', change: '-2.14%', state: '跌破 5 日线', trigger: '收复 327.2-335.0' },
  { rank: 4, name: '英伟达', code: 'usNVDA', close: '203.28', change: '+0.23%', state: '弱修复', trigger: '收复 205.6-207.6' },
  { rank: 5, name: 'Meta', code: 'usMETA', close: '645.85', change: '-0.02%', state: '弱势整理', trigger: '收复 647.5-659.8' },
  { rank: 6, name: '博通', code: 'usAVGO', close: '378.16', change: '+1.98%', state: '反弹未确认', trigger: '收复 380.2-385.1' },
  { rank: 7, name: '谷歌-A', code: 'usGOOGL', close: '351.99', change: '+1.51%', state: '弱修复', trigger: '收复 355.1-358.1' },
  { rank: 8, name: '标普500ETF', code: 'usSPY', close: '742.09', change: '-0.16%', state: '均线下方', trigger: '收复 744.8-749.2' },
  { rank: 9, name: '纳指100ETF', code: 'usQQQ', close: '696.06', change: '+0.10%', state: '低位横盘', trigger: '收复 707.0-711.6' },
  { rank: 10, name: 'AMD', code: 'usAMD', close: '503.57', change: '+1.58%', state: '弱反弹', trigger: '收复 515.5-531.3' },
  { rank: 11, name: '特斯拉', code: 'usTSLA', close: '369.57', change: '-2.96%', state: '最弱', trigger: '收复 386.4-396.3' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 25',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-21 收盘；美股 2026-07-20 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>宁德时代、海尔智家、比亚迪切到前排</strong>
          <p>宁德时代收复 5/10/20 日线且资金转强；招商银行跌破 5 日线。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>微软、亚马逊相对修复，美股整体仍弱</strong>
          <p>QQQ、SPY 仍在均线下方；特斯拉继续最弱，英伟达只是弱修复。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
