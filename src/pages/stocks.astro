---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '中国移动', code: 'sh600941', close: '91.43', change: '+1.61%', state: '放量突破', trigger: '守住 89.7，突破 91.5' },
  { rank: 2, name: '美的集团', code: 'sz000333', close: '80.40', change: '+1.79%', state: '强势延续', trigger: '守住 79.5，突破 80.7' },
  { rank: 3, name: '招商银行', code: 'sh600036', close: '37.25', change: '+1.00%', state: '强势整理', trigger: '守住 36.8，突破 37.4' },
  { rank: 4, name: '贵州茅台', code: 'sh600519', close: '1210.99', change: '+0.50%', state: '收复均线', trigger: '守住 1198，突破 1215' },
  { rank: 5, name: '海尔智家', code: 'sh600690', close: '20.25', change: '-0.49%', state: '横盘修复', trigger: '收复 20.35-20.57' },
  { rank: 6, name: '迈瑞医疗', code: 'sz300760', close: '139.68', change: '-1.34%', state: '均线边缘', trigger: '收复 139.7-143.5' },
  { rank: 7, name: '比亚迪', code: 'sz002594', close: '86.98', change: '-3.36%', state: '跌破 5 日线', trigger: '收复 87.6-90.8' },
  { rank: 8, name: '宁德时代', code: 'sz300750', close: '359.06', change: '+2.95%', state: '弱势反弹', trigger: '收复 363.4-373.1' },
];

const usRows = [
  { rank: 1, name: 'Meta', code: 'usMETA', close: '669.21', change: '+5.97%', state: '放量突破', trigger: '守住 624，突破 678' },
  { rank: 2, name: '英伟达', code: 'usNVDA', close: '210.96', change: '+4.03%', state: '放量转强', trigger: '守住 202，突破 211' },
  { rank: 3, name: 'AMD', code: 'usAMD', close: '557.89', change: '+2.04%', state: '强势延续', trigger: '守住 538，突破 572.5' },
  { rank: 4, name: '博通', code: 'usAVGO', close: '399.97', change: '-0.28%', state: '强势整理', trigger: '守住 386.9，突破 407.5' },
  { rank: 5, name: '纳指100ETF', code: 'usQQQ', close: '725.51', change: '+0.31%', state: '收复均线', trigger: '守住 718.5，突破 726.4' },
  { rank: 6, name: '标普500ETF', code: 'usSPY', close: '754.95', change: '+0.43%', state: '趋势偏强', trigger: '守住 750，突破 755.4' },
  { rank: 7, name: '苹果', code: 'usAAPL', close: '315.32', change: '-0.28%', state: '高位整理', trigger: '守住 313.6，突破 316.9' },
  { rank: 8, name: '特斯拉', code: 'usTSLA', close: '407.76', change: '+0.30%', state: '修复中', trigger: '收复 409-420' },
  { rank: 9, name: '亚马逊', code: 'usAMZN', close: '245.34', change: '-0.69%', state: '均线附近', trigger: '守住 245，突破 251' },
  { rank: 10, name: '微软', code: 'usMSFT', close: '385.10', change: '+0.19%', state: '弱整理', trigger: '收复 385.7-395.6' },
  { rank: 11, name: '谷歌-A', code: 'usGOOGL', close: '357.18', change: '-0.48%', state: '跌破均线', trigger: '收复 358-362.3' },
];

const dataCommands = [
  'westock-data kline ... --period day --limit 25',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-13 收盘；美股 2026-07-10 收盘。下一交易日使用时以开盘后的量价确认触发条件。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>中国移动、美的集团、招商银行短线靠前</strong>
          <p>中国移动放量站上 5/10/20 日线；宁德时代仍低于三条短均线。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>Meta、英伟达、AMD 带动科技线转强</strong>
          <p>QQQ 已收复 5/10/20 日线；谷歌仍是默认清单里最弱。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
