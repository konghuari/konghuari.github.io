---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '宁德时代', code: 'sz300750', close: '400.00', change: '+4.44%', state: '放量突破', trigger: '守住 384.7，突破 403.8' },
  { rank: 2, name: '海尔智家', code: 'sh600690', close: '21.87', change: '+0.51%', state: '高位延续', trigger: '守住 21.9，突破 22.0' },
  { rank: 3, name: '招商银行', code: 'sh600036', close: '39.00', change: '-0.51%', state: '强势整理', trigger: '守住 38.8，突破 39.4' },
  { rank: 4, name: '贵州茅台', code: 'sh600519', close: '1289.50', change: '-0.61%', state: '跌破 5 日线', trigger: '收复 1298.4-1344.7' },
  { rank: 5, name: '中国移动', code: 'sh600941', close: '94.39', change: '-0.32%', state: '均线边缘', trigger: '收复 94.5-96.5' },
  { rank: 6, name: '美的集团', code: 'sz000333', close: '84.13', change: '-0.44%', state: '高位整理', trigger: '收复 84.5-85.8' },
  { rank: 7, name: '比亚迪', code: 'sz002594', close: '92.40', change: '+0.55%', state: '弱修复', trigger: '收复 92.6-93.2' },
  { rank: 8, name: '迈瑞医疗', code: 'sz300760', close: '148.56', change: '+1.49%', state: '跌破短均', trigger: '收复 149.1-150.1' },
];

const usRows = [
  { rank: 1, name: '苹果', code: 'usAAPL', close: '333.02', change: 'K线缺口', state: '相对最强', trigger: '守住 328.3，突破 333.0' },
  { rank: 2, name: '英伟达', code: 'usNVDA', close: '206.84', change: 'K线缺口', state: '均线边缘', trigger: '收复 208.0-208.4' },
  { rank: 3, name: '微软', code: 'usMSFT', close: '381.70', change: 'K线缺口', state: '跌破均线', trigger: '收复 386.6-391.1' },
  { rank: 4, name: '博通', code: 'usAVGO', close: '381.92', change: 'K线缺口', state: '均线下方', trigger: '收复 382.3-387.9' },
  { rank: 5, name: 'AMD', code: 'usAMD', close: '521.95', change: 'K线缺口', state: '回落整理', trigger: '收复 525.8-536.1' },
  { rank: 6, name: '标普500ETF', code: 'usSPY', close: '738.93', change: 'K线缺口', state: '继续偏弱', trigger: '收复 742.4-746.7' },
  { rank: 7, name: '纳指100ETF', code: 'usQQQ', close: '684.23', change: 'K线缺口', state: '最弱指数', trigger: '收复 695.0-700.9' },
  { rank: 8, name: 'Meta', code: 'usMETA', close: '595.19', change: 'K线缺口', state: '跌破均线', trigger: '收复 613.5-636.6' },
  { rank: 9, name: '亚马逊', code: 'usAMZN', close: '232.11', change: 'K线缺口', state: '继续偏弱', trigger: '收复 238.1-244.0' },
  { rank: 10, name: '谷歌-A', code: 'usGOOGL', close: '319.74', change: 'K线缺口', state: '低位弱势', trigger: '收复 329.3-343.0' },
  { rank: 11, name: '特斯拉', code: 'usTSLA', close: '313.03', change: 'K线缺口', state: '最弱', trigger: '收复 339.7-363.1' },
];

const dataCommands = [
  'westock-data kline ... --limit 30',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-27 收盘；美股 technical 返回 2026-07-27。美股 K 线接口今日缺口，暂只用均线和指标观察。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>宁德时代放量突破，海尔智家和招商银行靠前</strong>
          <p>宁德时代站上 5/10/20 日线且主力净流入；茅台、中国移动、美的跌回 5 日线附近。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>苹果相对最强，多数美股仍在均线下方</strong>
          <p>NVDA 卡在 5/10 日线附近；QQQ、SPY、Meta、特斯拉均低于 5/10/20 日线。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
