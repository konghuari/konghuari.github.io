---
import BaseLayout from '../layouts/BaseLayout.astro';

const aShareRows = [
  { rank: 1, name: '招商银行', code: 'sh600036', close: '39.59', change: 'K线缺口', state: '资金转强', trigger: '守住 39.1，突破 39.6' },
  { rank: 2, name: '贵州茅台', code: 'sh600519', close: '1320.00', change: 'K线缺口', state: '重回强势', trigger: '守住 1300.8，突破 1320' },
  { rank: 3, name: '比亚迪', code: 'sz002594', close: '93.35', change: 'K线缺口', state: '收复均线', trigger: '守住 92.9，突破 93.4' },
  { rank: 4, name: '海尔智家', code: 'sh600690', close: '22.40', change: 'K线缺口', state: '高位延续', trigger: '守住 22.0，突破 22.4' },
  { rank: 5, name: '美的集团', code: 'sz000333', close: '85.37', change: 'K线缺口', state: '趋势延续', trigger: '守住 84.7，突破 85.4' },
  { rank: 6, name: '中国移动', code: 'sh600941', close: '96.35', change: 'K线缺口', state: '趋势延续', trigger: '守住 94.8，突破 96.4' },
  { rank: 7, name: '迈瑞医疗', code: 'sz300760', close: '150.54', change: 'K线缺口', state: '均线修复', trigger: '守住 150.1，突破 150.5' },
  { rank: 8, name: '宁德时代', code: 'sz300750', close: '390.86', change: 'K线缺口', state: '强势整理', trigger: '守住 386.4，突破 390.9' },
];

const usRows = [
  { rank: 1, name: '苹果', code: 'usAAPL', close: '336.91', change: 'K线缺口', state: '相对最强', trigger: '守住 329.0，突破 336.9' },
  { rank: 2, name: '微软', code: 'usMSFT', close: '389.10', change: 'K线缺口', state: '弱修复', trigger: '收复 391.8' },
  { rank: 3, name: '博通', code: 'usAVGO', close: '383.22', change: 'K线缺口', state: '均线边缘', trigger: '收复 384.8-388.2' },
  { rank: 4, name: '标普500ETF', code: 'usSPY', close: '739.09', change: 'K线缺口', state: '继续偏弱', trigger: '收复 742.4-746.7' },
  { rank: 5, name: 'AMD', code: 'usAMD', close: '494.95', change: 'K线缺口', state: '回落偏弱', trigger: '收复 523.1-530.7' },
  { rank: 6, name: '谷歌-A', code: 'usGOOGL', close: '326.56', change: 'K线缺口', state: '低位修复', trigger: '收复 330.7-343.7' },
  { rank: 7, name: '英伟达', code: 'usNVDA', close: '196.51', change: 'K线缺口', state: '跌破均线', trigger: '收复 203.5-206.9' },
  { rank: 8, name: '纳指100ETF', code: 'usQQQ', close: '682.12', change: 'K线缺口', state: '指数弱势', trigger: '收复 694.5-700.7' },
  { rank: 9, name: 'Meta', code: 'usMETA', close: '593.87', change: 'K线缺口', state: '继续偏弱', trigger: '收复 613.2-636.5' },
  { rank: 10, name: '亚马逊', code: 'usAMZN', close: '231.39', change: 'K线缺口', state: '继续偏弱', trigger: '收复 237.9-243.9' },
  { rank: 11, name: '特斯拉', code: 'usTSLA', close: '309.22', change: 'K线缺口', state: '最弱', trigger: '收复 339.0-362.7' },
];

const dataCommands = [
  'westock-data kline ... --limit 30',
  'westock-data technical ... --group ma,macd,rsi,kdj',
  'westock-data asfund ...',
];
---
<BaseLayout
  title="股票分析 — helios"
  description="helios 的 A 股和美股短期观察。"
  active="stocks"
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-tag">A 股 · 美股 · 短期观察</span>
      <h1>股票分析</h1>
      <p>每日把量价、均线、指标和资金流拆成可复盘的短线观察，不写买卖指令。</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">最新短期观察</h2>
      <p class="section-sub">数据基准：A 股 2026-07-28 收盘；美股 technical 返回 2026-07-28。K 线接口今日缺口，暂只用均线、指标和 A 股资金流观察。</p>
      <div class="market-summary">
        <article>
          <span>A 股</span>
          <strong>招商银行、贵州茅台、比亚迪资金转强</strong>
          <p>A 股观察清单全部站上 5/10/20 日线；招商银行、茅台、比亚迪主力净流入。</p>
        </article>
        <article>
          <span>美股</span>
          <strong>苹果继续最强，美股多数仍低于短均线</strong>
          <p>微软弱修复；NVDA、QQQ、Meta、亚马逊、特斯拉仍在 5/10/20 日线下方。</p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">A 股强弱排名</h2>
      <p class="section-sub">短线只看 1-10 个交易日维度：涨跌、量能、均线和资金流。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>触发条件</th>
            </tr>
          </thead>
          <tbody>
            {aShareRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">美股强弱排名</h2>
      <p class="section-sub">中国时间下午的报告使用上一美股交易日收盘数据。</p>
      <div class="stock-table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>排名</th>
              <th>股票</th>
              <th>收盘</th>
              <th>1 日</th>
              <th>状态</th>
              <th>下个交易日触发</th>
            </tr>
          </thead>
          <tbody>
            {usRows.map(row => (
              <tr>
                <td>{row.rank}</td>
                <td><strong>{row.name}</strong><small>{row.code}</small></td>
                <td>{row.close}</td>
                <td class={row.change.startsWith('+') ? 'up' : 'down'}>{row.change}</td>
                <td>{row.state}</td>
                <td>{row.trigger}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">使用说明</h2>
      <p class="section-sub">这里只放短线研究观察。触发条件不是买入信号，跌破失效条件也不是卖出指令。</p>
      <div class="note-template">
        <p><strong>观察口径：</strong>最近 1/3/5/10 个交易日，5/10/20 日均线，MACD/RSI/KDJ，A 股资金流。</p>
        <p><strong>风险提示：</strong>隔夜消息、指数跳空、成交量不足都会让预案失效。</p>
        <p><strong>数据命令：</strong>{dataCommands.join('；')}</p>
        <p><strong>声明：</strong>这是研究记录，不是投资建议。</p>
      </div>
    </div>
  </section>
</BaseLayout>
